# PostgREST write credential (HS256 JWT for role laptimes_api).
#
# Local development: copy this file to .env.local and paste the token printed by
#   deployment/setup-api-auth.sh
# or mint one directly:
#   ssh hosting@hosting "podman secret inspect --showsecret pg_jwt_secret --format '{{.SecretData}}'" \
#     | node deployment/mint-token.mjs
#
# Production builds get the token from deploy.sh as a Docker build argument.
# Reads work without a token; writes are rejected without it.
# Never commit a real value.
VUE_APP_PGRST_JWT=
