[Unit]
Description=pc2-laptimes PostgREST API (least-privilege roles, JWT-gated writes)
After=pc2-laptimes-postgres.service
Requires=pc2-laptimes-postgres.service

[Container]
ContainerName=pc2-laptimes-api
Image=docker.io/postgrest/postgrest:latest
PodmanArgs=--memory=128m
Pod=pc2-laptimes.pod
Secret=pg_api_uri
Secret=pg_jwt_secret
Environment=PGRST_DB_URI=@/run/secrets/pg_api_uri
Environment=PGRST_DB_SCHEMA=public
Environment=PGRST_DB_ANON_ROLE=laptimes_anon
Environment=PGRST_JWT_SECRET=@/run/secrets/pg_jwt_secret
Environment=PGRST_DB_CHANNEL_ENABLED=false
Environment=PGRST_OPENAPI_SERVER_PROXY_URI=http://192.168.0.102:3000

[Service]
Restart=always

[Install]
WantedBy=default.target
